{
  "name": "pi-stall-recovery",
  "version": "0.1.0",
  "type": "module",
  "description": "Recover the pi coding agent from silent model stalls \u2014 turns that end with no message and no tool call while the task is unfinished.",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "llm",
    "qwen",
    "llama.cpp",
    "agent"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Lukasz Olszewski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukolszewski/pi-stall-recovery.git"
  },
  "bugs": {
    "url": "https://github.com/lukolszewski/pi-stall-recovery/issues"
  },
  "homepage": "https://github.com/lukolszewski/pi-stall-recovery#readme",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "detect.ts",
    "config.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "vitest": "^1.6.0"
  }
}
